# Koneksi PostgreSQL Supabase: Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
# Ganti [YOUR-PASSWORD] dengan password database.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Wajib diisi di production (min. 32 karakter acak)
SESSION_SECRET=ganti-dengan-string-acak-panjang
# Akun admin Gudcare yang dibuat otomatis saat database pertama kali dibuat
ADMIN_EMAIL=admin@gudcare.local
ADMIN_PASSWORD=gudcare123
# Isi false hanya jika diakses lewat HTTP biasa (tanpa HTTPS), karena cookie login default-nya hanya lewat HTTPS
# COOKIE_SECURE=false

# Login Google untuk dashboard (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, tipe Web application).
# Authorized redirect URI: https://<domain-kamu>/api/auth/google/callback (dan http://localhost:3000/api/auth/google/callback untuk lokal)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opsional: domain utama, dipakai untuk redirect URI Google (mis. https://survey.gudcare.id)
# APP_URL=
